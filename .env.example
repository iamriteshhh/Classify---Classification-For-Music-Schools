# CLASSIFY Environment Variables Template
# Copy this file to .env and adjust values for your environment.

# Selects configuration class: development, testing, production
FLASK_ENV=development
FLASK_CONFIG=development

# Secret key for Flask sessions & CSRF protection
SECRET_KEY=replace-this-with-a-secure-random-secret-key

# Path for runtime user uploads
UPLOAD_FOLDER=uploads

# Maximum allowed upload file size in bytes (e.g., 26214400 = 25 MB)
MAX_CONTENT_LENGTH=26214400

# Per-student storage quota in megabytes (e.g. 500 MB)
UPLOAD_QUOTA_MB=500

# Allowed audio file extensions (comma-separated)
ALLOWED_AUDIO_EXTENSIONS=wav,mp3

# SQLite file path or database connection string
DATABASE_URL=sqlite:///classify.db

# Path to the trained ML model artifact
MODEL_ARTIFACT_PATH=model_artifacts/genre_classifier.joblib

# Email / SMTP Configuration
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@classify.music
MAIL_SUPPRESS_SEND=false
